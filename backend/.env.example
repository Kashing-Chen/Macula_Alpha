# 大模型 API 配置 — 复制为 .env 后填入真实密钥
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=

# 滴答清单官方 MCP（Streamable HTTP）
# 文档：https://help.dida365.com/articles/7438132116019216384
DIDA365_MCP_ENABLED=true
DIDA365_MCP_URL=https://mcp.dida365.com
# 在 Cursor / Claude 等客户端完成 OAuth 授权后，将 Bearer Token 填入此处
DIDA365_MCP_TOKEN=

# 以下为可选项，一般无需修改：
# PORT=4000
# STORAGE_DIR=../storage/data
# CORS_ORIGIN=*
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
